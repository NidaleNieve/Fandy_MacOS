<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>is.dsr.fandy.fan-control-v2</string>
<!-- The app enforces this installation location before registration. This avoids
     BundleProgram resolution through a stale/missing BTM parent container. -->
<key>Program</key><string>/Applications/Fandy.app/Contents/Library/HelperTools/FandyFanHelper</string>
<key>ProgramArguments</key><array><string>FandyFanHelper</string></array>
<key>MachServices</key><dict><key>is.dsr.fandy.fan-helper</key><true/></dict>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>ThrottleInterval</key><integer>2</integer>
<key>ProcessType</key><string>Interactive</string>
</dict></plist>
